# 1. Neon Serverless PostgreSQL Connection String
# Get from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Auth.js (NextAuth v5) Secret
# Generate one via: npx auth secret
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars"

# 3. Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:9002/api/auth/callback/google (and https://your-domain.vercel.app/api/auth/callback/google)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# 4. Gemini API Key (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
