# 1. Neon Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Auth.js (NextAuth v5) Secret
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars"

# 3. Google OAuth Credentials (Optional)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# 4. Multi-Provider Free AI Router Keys (Auto-Fallback)
# Provider 1: NVIDIA NIM Free 1M-Context Models (https://build.nvidia.com)
# Uses nvidia/nemotron-3-super-120b-a12b (1M context) & meta/llama-4-maverick-17b-128e-instruct (Vision + 1M context)
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Provider 2: Google Gemini 2.5 Flash (1M Context Free Tier - https://aistudio.google.com/apikey)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Provider 3: Groq Cloud Free Tier (14,400 req/day - https://console.groq.com/keys)
GROQ_API_KEY="gsk_your-groq-api-key"
GROQ_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# Provider 4: OpenRouter Free Tier (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OPENROUTER_MODEL="meta-llama/llama-4-maverick:free"
